[Unit]
Description=english-tracker: painel sempre no ar (somente leitura)
After=network-online.target

[Service]
# Quem traz o log do Drive é o english-tracker-sync.timer, com conta de serviço.
# O painel só serve o que está no disco — ele nunca vai à rede para renderizar,
# de propósito: página instantânea, e "Atualizar" não vira "Puxar".
# Painel COMPLETO, com os botões: a senha é a tranca, e a operação destrutiva
# (apagar dia) passou a partir do conteúdo fresco do Drive, não do cache local —
# que era o risco real de ter dois escritores.
# ⚠️ A senha viaja em HTTP puro nesta rede. Numa LAN doméstica é aceitável; para
# sair dela, use Tailscale com `tailscale serve` (que põe HTTPS na frente).
ExecStart=%h/pessoal/english-tracker/.venv/bin/english-tracker serve \
  --host 0.0.0.0 --sem-abrir --com-senha
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
