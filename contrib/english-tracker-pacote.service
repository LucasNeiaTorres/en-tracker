[Unit]
Description=english-tracker: puxa o log e publica o pacote de prompts no Drive
# Habilite este timer nas DUAS máquinas. As duas publicarem o mesmo arquivo
# gerado é inofensivo — mesmo conteúdo, sobrescrita inteira —, enquanto NENHUMA
# publicar deixa você sem prompt no celular. Os custos são assimétricos, e a
# redundância é de graça: o servidor publica de madrugada, o notebook publica
# quando estiver ligado, e um cobre a queda do outro.
Documentation=file:%h/pessoal/english-tracker/COMO-USAR.md

[Service]
Type=oneshot
# O "-" faz o systemd ignorar a falha: sem rede, o pull falha e o pacote ainda
# é gerado a partir do cache local — melhor um pacote levemente velho do que
# nenhum.
ExecStart=-%h/pessoal/english-tracker/.venv/bin/english-tracker pull
ExecStart=%h/pessoal/english-tracker/.venv/bin/english-tracker prompt --pacote 7 --para-o-drive
