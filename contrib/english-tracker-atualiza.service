[Unit]
Description=english-tracker: puxa a versão nova do GitHub e reinicia o painel

[Service]
Type=oneshot
WorkingDirectory=%h/pessoal/english-tracker
# O deploy é PUXADO, não empurrado: o GitHub não alcança uma máquina atrás de
# NAT, e abrir porta para ele seria trocar um problema pequeno por um grande.
ExecStart=/usr/bin/git pull --ff-only
ExecStart=%h/pessoal/english-tracker/.venv/bin/pip install -e . --quiet

# O portão. Nenhum "-" nestas linhas, de propósito: como o Type é oneshot, uma
# falha aqui ABORTA os ExecStart seguintes — o restart não acontece e o painel
# continua servindo a última versão que passou nos próprios testes. Sem isto, um
# commit quebrado chegaria ao ar em 15 minutos mesmo com o CI vermelho.
ExecStart=%h/pessoal/english-tracker/.venv/bin/python -m pytest tests/ -q

# As unidades também se atualizam. Sem isto, o `git pull` traria a versão nova
# para contrib/ e o systemd continuaria lendo a cópia velha em ~/.config — o
# deploy atualizaria o código e nunca a si mesmo. Só as duas unidades desta
# máquina: a do pacote é do notebook e não deve existir aqui.
ExecStart=/usr/bin/install -m 644 -t %h/.config/systemd/user/ contrib/english-tracker-painel.service contrib/english-tracker-atualiza.service contrib/english-tracker-atualiza.timer
ExecStart=/usr/bin/systemctl --user daemon-reload

ExecStart=/usr/bin/systemctl --user restart english-tracker-painel.service
